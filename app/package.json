{
    "name": "spot_micro_controller",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "pnpm model && vite dev --host",
        "build": "pnpm proto && pnpm model && vite build",
        "build:embedded": "pnpm proto && cross-env PUBLIC_EMBEDDED_BUILD=true vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test:unit": "vitest",
        "proto": "node scripts/compile_protos.js",
        "model": "node scripts/build_sim_models.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/tabler": "^1.2.42",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@types/eslint": "^9.6.1",
        "@types/three": "^0.180.0",
        "@types/w3c-web-serial": "^1.0.9",
        "@types/web-bluetooth": "^0.0.21",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "jsdom": "^27.4.0",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^3.5.2",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.7",
        "svelte-focus-trap": "^1.2.0",
        "tailwindcss": "^4.3.3",
        "ts-proto-descriptors": "^2.1.0",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "unplugin-icons": "^22.5.0",
        "vite": "^7.3.7",
        "vitest": "^4.1.12",
        "ws": "^8.22.0"
    },
    "type": "module",
    "dependencies": {
        "@bufbuild/protobuf": "^2.16.0",
        "@mujoco/mujoco": "3.14.0",
        "@tailwindcss/vite": "^4.3.3",
        "chart.js": "^4.6.1",
        "cross-env": "^10.1.0",
        "daisyui": "^5.7.50",
        "nipplejs": "^0.10.2",
        "svelte-dnd-list": "^0.1.8",
        "svelte-modals": "^2.0.1",
        "three": "^0.180.0",
        "ts-proto": "^2.18.1",
        "urdf-loader": "^0.12.7",
        "uzip": "^0.20201231.0",
        "xacro-parser": "^0.3.11"
    },
    "packageManager": "pnpm@9.3.0",
    "pnpm": {
        "overrides": {
            "cookie": "^0.7.2"
        }
    }
}
