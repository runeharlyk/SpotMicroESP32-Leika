    {"error": null, "clip": {"name": "plain", "schema": 1, "keyframes": [{"time": 0}, {"time": 1}]}},
    {"error": null, "clip": {"name": "float32-end", "schema": 1, "keyframes": [{"time": 0}, {"time": 1}],
      "overlays": [{"bodyAxis": 0, "amplitude": 1, "frequency": 1, "start": 0, "end": 1.00000001}]}},
    {"error": "overlay end is after the last keyframe", "clip": {"name": "float32-past-end", "schema": 1,
      "keyframes": [{"time": 0}, {"time": 1}],
      "overlays": [{"bodyAxis": 0, "amplitude": 1, "frequency": 1, "start": 0, "end": 1.0000002}]}},
    {"error": "schema is not 1", "clip": {"name": "schema", "schema": 2, "keyframes": [{"time": 0}]}},
    {"error": "name must be 1-32 characters of [a-z0-9_-]", "clip": {"name": "Upper", "schema": 1, "keyframes": [{"time": 0}]}},
    {"error": "name must be 1-32 characters of [a-z0-9_-]", "clip": {"name": "", "schema": 1, "keyframes": [{"time": 0}]}},
    {"error": "loop and hold_end cannot both be set", "clip": {"name": "loop-hold", "schema": 1, "loop": true, "holdEnd": true,
      "keyframes": [{"time": 0}]}},
    {"error": "at least one keyframe is required", "clip": {"name": "empty", "schema": 1}},
    {"error": "keyframe must have 0 or 4 legs", "clip": {"name": "three-legs", "schema": 1,
      "keyframes": [{"time": 0, "legs": [{"foot": {}}, {"foot": {}}, {"foot": {}}]}]}},
    {"error": "keyframe ease out of range", "clip": {"name": "ease", "schema": 1, "keyframes": [{"time": 0, "ease": 7}]}},
    {"error": "entry/exit time must be finite", "clip": {"name": "entry", "schema": 1, "entryTime": "Infinity",
      "keyframes": [{"time": 0}]}},
    {"error": "ride_height must be positive", "clip": {"name": "ride-zero", "schema": 1, "rideHeight": 0, "keyframes": [{"time": 0}]}},
    {"error": "ride_height must be positive", "clip": {"name": "ride-inf", "schema": 1, "rideHeight": "Infinity", "keyframes": [{"time": 0}]}},
    {"error": "ride_height must be positive", "clip": {"name": "ride-nan", "schema": 1, "rideHeight": "NaN", "keyframes": [{"time": 0}]}},
    {"error": "keyframe time must be finite", "clip": {"name": "time-nan", "schema": 1, "keyframes": [{"time": 0}, {"time": "NaN"}]}},
    {"error": "keyframe body must be finite", "clip": {"name": "body-nan", "schema": 1,
      "keyframes": [{"time": 0, "body": {"roll": "NaN"}}]}},
    {"error": "keyframe leg must be finite", "clip": {"name": "leg-inf", "schema": 1,
      "keyframes": [{"time": 0, "legs": [{"foot": {}}, {"foot": {}}, {"joints": {"femur": "-Infinity"}}, {"foot": {}}]}]}},
    {"error": "overlay must be finite", "clip": {"name": "overlay-nan", "schema": 1, "keyframes": [{"time": 0}, {"time": 1}],
      "overlays": [{"footChannel": 2, "amplitude": "NaN", "frequency": 1, "start": 0, "end": 1}]}},
    {"error": "param must be finite", "clip": {"name": "param-inf", "schema": 1, "keyframes": [{"time": 0}],
      "params": [{"id": "BODY_X", "min": "-Infinity", "defaultValue": 1, "max": 2}]}},
    {"error": "first keyframe must be at time 0", "clip": {"name": "late", "schema": 1, "keyframes": [{"time": 0.5}]}},
    {"error": "keyframe time must increase", "clip": {"name": "repeat-time", "schema": 1,
      "keyframes": [{"time": 0}, {"time": 1}, {"time": 1}]}},
