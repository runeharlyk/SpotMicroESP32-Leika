      "params": [{"id": 10, "min": 0, "defaultValue": 1, "max": 2}]}},
    {"error": "param id is not unique", "clip": {"name": "twice", "schema": 1, "keyframes": [{"time": 0}],
      "params": [{"id": "SPEED", "min": 0.5, "defaultValue": 1, "max": 2}, {"id": "SPEED", "min": 0.5, "defaultValue": 1, "max": 2}]}},
    {"error": "param needs min <= default_value <= max", "clip": {"name": "default", "schema": 1, "keyframes": [{"time": 0}],
      "params": [{"id": "BODY_Z", "min": 2, "defaultValue": 1, "max": 3}]}},
    {"error": "param SPEED needs a positive min", "clip": {"name": "speed", "schema": 1, "keyframes": [{"time": 0}],
      "params": [{"id": "SPEED", "min": 0, "defaultValue": 1, "max": 2}]}},
    {"error": "param REPEAT needs min >= 1", "clip": {"name": "repeat", "schema": 1, "keyframes": [{"time": 0}],
      "params": [{"id": "REPEAT", "min": 0.5, "defaultValue": 1, "max": 3}]}}
  ]
