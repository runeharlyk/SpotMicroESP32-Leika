    {"error": "overlay body_axis out of range", "clip": {"name": "axis", "schema": 1, "keyframes": [{"time": 0}, {"time": 1}],
      "overlays": [{"bodyAxis": 6, "amplitude": 1, "frequency": 1, "start": 0, "end": 1}]}},
    {"error": "overlay foot_channel out of range", "clip": {"name": "channel", "schema": 1, "keyframes": [{"time": 0}, {"time": 1}],
      "overlays": [{"footChannel": 12, "amplitude": 1, "frequency": 1, "start": 0, "end": 1}]}},
    {"error": "overlay window must have 0 <= start < end", "clip": {"name": "window", "schema": 1, "keyframes": [{"time": 0}, {"time": 1}],
