# HTTP Server WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# A socket counts as writable once half its send buffer is free: room for one whole 16 KB file chunk, so
# downloads never block the socket's task on a send (FS_MAX_CHUNK_SIZE)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=34816

# WiFi driver buffers come from the heap, about 1.6 KB each; on a slow link the default 32 of each held up to
# 100 KB, which a board without PSRAM does not have, and the next allocation failed
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# A new firmware boots on probation and rolls back unless it accepts a socket client first (ota_flash.h)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The whole ELF SHA-256 in the app description, not the first 9 characters: the app compares it with the image file's
# to tell an update that came up from a rollback
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64

# mDNS
CONFIG_MDNS_MAX_SERVICES=10

# LittleFS
CONFIG_LITTLEFS_MAX_PARTITIONS=3

#
# ESP System Settings
#
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80 is not set
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# PSRAM: boards without it boot with internal RAM only; line mode and speed live in sdkconfig.defaults.<target>
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# DSP library
CONFIG_DSP_MAX_FFT_SIZE_4096=y

# Compiler; stack canaries catch a smashed stack where it happens, not later as a stray crash.
# NORM, not STRONG: STRONG crashes GCC 14.2 on esp-dsp's dspi_conv_f32_ansi.c for esp32dev.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# A crash leaves an ELF core dump in the coredump partition, readable with esp-coredump; tables
# without that partition (default_8MB.csv) only log that there is none
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y

# CONFIG_FATFS_LFN_NONE is not set
# CONFIG_FATFS_LFN_HEAP is not set
CONFIG_FATFS_LFN_STACK=y